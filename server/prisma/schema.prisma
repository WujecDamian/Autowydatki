generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int            @id @default(autoincrement())
  email        String         @unique
  passwordHash String?        @map("password_hash")
  googleId     String?        @unique @map("google_id")
  name         String?
  avatarUrl    String?        @map("avatar_url")
  cars         Car[]
  fuelEntries  FuelEntry[]
  services     ServiceEntry[]
  fuelStations FuelStation[]

  @@map("users")
}

model Car {
  id            Int            @id @default(autoincrement())
  userId        Int            @map("user_id")
  name          String
  purchasePrice Decimal?       @map("purchase_price") @db.Decimal(12, 2)
  user          User           @relation(fields: [userId], references: [id])
  fuelEntries   FuelEntry[]
  services      ServiceEntry[]

  @@map("cars")
}

model FuelEntry {
  id         Int          @id @default(autoincrement())
  userId     Int          @map("user_id")
  carId      Int          @map("car_id")
  entryDate  DateTime     @map("entry_date") @db.Date
  odometerKm Int          @map("odometer_km")
  liters     Decimal      @db.Decimal(8, 2)
  totalCost  Decimal      @map("total_cost") @db.Decimal(10, 2)
  stationId  Int?         @map("station_id")
  user       User         @relation(fields: [userId], references: [id])
  car        Car          @relation(fields: [carId], references: [id])
  station    FuelStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@map("fuel_entries")
}

// Rows without a user are the built-in Polish brands seeded by the migration.
model FuelStation {
  id          Int         @id @default(autoincrement())
  userId      Int?        @map("user_id")
  name        String
  user        User?       @relation(fields: [userId], references: [id])
  fuelEntries FuelEntry[]

  @@index([userId])
  @@map("fuel_stations")
}

enum ServiceKind {
  REPAIR
  INSPECTION
}

// The entry's cost is the sum of its items.
model ServiceEntry {
  id         Int           @id @default(autoincrement())
  userId     Int           @map("user_id")
  carId      Int           @map("car_id")
  kind       ServiceKind   @default(REPAIR)
  entryDate  DateTime      @map("entry_date") @db.Date
  odometerKm Int           @map("odometer_km")
  title      String?
  user       User          @relation(fields: [userId], references: [id])
  car        Car           @relation(fields: [carId], references: [id])
  items      ServiceItem[]

  @@map("service_entries")
}

model ServiceItem {
  id             Int          @id @default(autoincrement())
  serviceEntryId Int          @map("service_entry_id")
  category       String
  name           String
  cost           Decimal      @db.Decimal(10, 2)
  serviceEntry   ServiceEntry @relation(fields: [serviceEntryId], references: [id], onDelete: Cascade)

  @@index([serviceEntryId])
  @@map("service_items")
}
