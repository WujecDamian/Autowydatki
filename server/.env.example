PORT=3001

# Local PostgreSQL (include your DB user, Prisma does not fall back to the OS user):
DATABASE_URL=postgres://youruser@localhost:5432/autowydatki
DATABASE_SSL=false
# Supabase (Project Settings -> Database -> Connection string -> Session pooler):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (leave DATABASE_SSL unset)

# Frontend origin(s) allowed by CORS, comma separated, no trailing slash
CORS_ORIGIN=http://localhost:5173

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-change-me
ADMIN_EMAIL=admin@autowydatki.pl
ADMIN_PASSWORD=autowydatki

# Google sign-in: OAuth client ID (type Web) from Google Cloud Console. Leave empty to disable.
GOOGLE_CLIENT_ID=

# Photo storage: Supabase project URL (without /rest/v1/), secret/service_role key and a public bucket.
# Leave SUPABASE_URL empty to store photos in server/uploads (local development only).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=car-photos
